{
  "compilerOptions": {
    "target": "ES2017",                        // Nivel de JS que se va a generar (se subió de ES2016 a ES2017 para habilitar Object.entries)
    "module": "commonjs",                      // Tipo de módulo usado por Node.js
    "outDir": "./dist",                        // Carpeta donde se generará el código JS
    "rootDir": "./src",                        // Carpeta raíz del código fuente TS
    "strict": true,                            // Activa las comprobaciones estrictas de tipos
    "esModuleInterop": true,                   // Permite importar módulos CommonJS como si fueran ES6
    "forceConsistentCasingInFileNames": true,  // Evita errores por mayúsculas/minúsculas
    "skipLibCheck": true,                      // Omite la comprobación de tipos en node_modules
    "resolveJsonModule": true,                 // Permite importar archivos .json
    "moduleResolution": "node",                // Forma de resolver los módulos
    "allowSyntheticDefaultImports": true,      // Permite importar default aunque el módulo no lo tenga
    "isolatedModules": true,                   // Cada archivo es un módulo independiente
    "jsx": "react-jsx",                        // Para proyectos con React 17+
    "lib": ["DOM", "ES2017"]                   // Librerías incluidas: DOM y ES2017 para habilitar métodos como Object.entries
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
